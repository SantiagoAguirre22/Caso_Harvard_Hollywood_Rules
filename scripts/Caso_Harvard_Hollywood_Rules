modelo_7e_final <- modelo_7e

repeat {
  pvals <- summary(modelo_7e_final)$coefficients[, 4]
  pvals <- pvals[-1]
  
  if (max(pvals) > 0.10) {
    variable_eliminar <- names(which.max(pvals))
    modelo_7e_final <- update(modelo_7e_final, paste(". ~ . -", variable_eliminar))
  } else {
    break
  }
}

summary(modelo_7e_final)

tabla_7e_final <- tidy(modelo_7e_final) %>%
  rename(
    Variable = term,
    Coeficiente = estimate,
    `Error estándar` = std.error,
    `Valor p` = p.value
  )

tabla_7e_final_gt <- tabla_7e_final %>%
  gt() %>%
  tab_header(
    title = md("**Modelo Final del Punto 7e**")
  ) %>%
  fmt_number(
    columns = c(Coeficiente, `Error estándar`, `Valor p`),
    decimals = 6
  ) %>%
  cols_align(
    align = "center",
    columns = everything()
  ) %>%
  tab_options(
    table.width = pct(95),
    heading.align = "center",
    table.font.size = px(12),
    data_row.padding = px(6)
  )

invisible(tabla_7e_final_gt)

