# ---------------------------------------------------------
# Punto 5
# ---------------------------------------------------------

# ---------------------------------------------------------
# Inciso (a)
# ---------------------------------------------------------

modelo_5a <- lm(Total_US_Gross ~ Budget + Comedy + MPAA_D + Sequel + Known_Story,
                data = data)

summary(modelo_5a)

tabla_5a <- tidy(modelo_5a) %>%
  rename(
    Variable = term,
    Coeficiente = estimate,
    `Error estándar` = std.error,
    `Valor p` = p.value
  )

tabla_5a_gt <- tabla_5a %>%
  gt() %>%
  tab_header(
    title = md("**Modelo Inicial para Total_US_Gross**")
  ) %>%
  fmt_number(
    columns = c(Coeficiente, `Error estándar`, `Valor p`),
    decimals = 6
  ) %>%
  cols_align(
    align = "center",
    columns = everything()
  ) %>%
  tab_options(
    table.width = pct(95),
    heading.align = "center",
    table.font.size = px(12),
    data_row.padding = px(6)
  )

invisible(tabla_5a_gt)

# ---------------------------------------------------------
# Inciso (b)
# ---------------------------------------------------------

modelo_5b <- modelo_5a

repeat {
  pvals <- summary(modelo_5b)$coefficients[, 4]
  pvals <- pvals[-1]
  
  if (max(pvals) > 0.10) {
    variable_eliminar <- names(which.max(pvals))
    modelo_5b <- update(modelo_5b, paste(". ~ . -", variable_eliminar))
  } else {
    break
  }
}

summary(modelo_5b)

tabla_5b <- tidy(modelo_5b) %>%
  rename(
    Variable = term,
    Coeficiente = estimate,
    `Error estándar` = std.error,
    `Valor p` = p.value
  )

tabla_5b_gt <- tabla_5b %>%
  gt() %>%
  tab_header(
    title = md("**Modelo Final para Total_US_Gross**")
  ) %>%
  fmt_number(
    columns = c(Coeficiente, `Error estándar`, `Valor p`),
    decimals = 6
  ) %>%
  cols_align(
    align = "center",
    columns = everything()
  ) %>%
  tab_options(
    table.width = pct(95),
    heading.align = "center",
    table.font.size = px(12),
    data_row.padding = px(6)
  )

invisible(tabla_5b_gt)

