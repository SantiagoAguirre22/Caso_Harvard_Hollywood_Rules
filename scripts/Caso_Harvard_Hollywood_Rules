# Llamar librerías
library(readxl)
library(dplyr)
library(ggplot2)
library(broom)
library(gt)
library(htmlwidgets)
library(car)
library(scales)

# Definir carpeta de trabajo
setwd("C:/Users/Usuario/Documents")
getwd()

# Quitar notación científica
options(scipen = 999)

# Crear formato de gráficas
formato_grafica <- theme_gray() +
  theme(
    plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
    axis.title = element_text(size = 11),
    axis.text = element_text(size = 10)
  )

# ---------------------------------------------------------
# Lectura de datos
# ---------------------------------------------------------

data <- read_excel("Hollywood.xls", sheet = "Exhibit 1")

# Limpiar nombres de columnas
names(data) <- trimws(names(data))

# Renombrar variables para evitar errores con espacios y símbolos
names(data)[names(data) == "Opening Gross"] <- "Opening_Gross"
names(data)[names(data) == "Total U.S. Gross"] <- "Total_US_Gross"
names(data)[names(data) == "Total Non-U.S. Gross"] <- "Total_Non_US_Gross"
names(data)[names(data) == "Opening Theatres"] <- "Opening_Theatres"
names(data)[names(data) == "Known Story"] <- "Known_Story"

# Renombrar la variable de críticos de forma robusta
names(data)[grepl("Critics", names(data))] <- "Critics_Opinion"

# Revisar estructura de los datos
str(data)
head(data)

# Eliminar filas con datos faltantes
data <- na.omit(data)

# Crear variable auxiliar para comedia
data <- data %>%
  mutate(Comedy = ifelse(Genre == "Comedy", 1, 0))

# Crear ROI de EE. UU.
data <- data %>%
  mutate(ROI_US = (Total_US_Gross - Budget) / Budget)

# ---------------------------------------------------------
# Punto 1
# ---------------------------------------------------------

tabla_punto_1 <- data.frame(
  Variable = c("Opening_Gross", "Total_US_Gross", "Total_Non_US_Gross", "Opening_Theatres"),
  Minimum = c(
    min(data$Opening_Gross, na.rm = TRUE),
    min(data$Total_US_Gross, na.rm = TRUE),
    min(data$Total_Non_US_Gross, na.rm = TRUE),
    min(data$Opening_Theatres, na.rm = TRUE)
  ),
  Average = c(
    mean(data$Opening_Gross, na.rm = TRUE),
    mean(data$Total_US_Gross, na.rm = TRUE),
    mean(data$Total_Non_US_Gross, na.rm = TRUE),
    mean(data$Opening_Theatres, na.rm = TRUE)
  ),
  Maximum = c(
    max(data$Opening_Gross, na.rm = TRUE),
    max(data$Total_US_Gross, na.rm = TRUE),
    max(data$Total_Non_US_Gross, na.rm = TRUE),
    max(data$Opening_Theatres, na.rm = TRUE)
  )
)

tabla_punto_1_gt <- tabla_punto_1 %>%
  gt() %>%
  tab_header(
    title = md("**Resumen Inicial de Variables**")
  ) %>%
  fmt_number(
    columns = c(Minimum, Average, Maximum),
    decimals = 2
  ) %>%
  cols_align(
    align = "center",
    columns = everything()
  ) %>%
  tab_options(
    table.width = pct(85),
    heading.align = "center",
    table.font.size = px(13),
    data_row.padding = px(6)
  )

invisible(tabla_punto_1_gt)

tabla_conteos_1 <- data.frame(
  Concepto = c("Número de comedias", "Número de películas R-rated"),
  Valor = c(
    sum(data$Genre == "Comedy", na.rm = TRUE),
    sum(data$MPAA_D == 1, na.rm = TRUE)
  )
)

tabla_conteos_1_gt <- tabla_conteos_1 %>%
  gt() %>%
  tab_header(
    title = md("**Conteos Solicitados**")
  ) %>%
  fmt_number(
    columns = Valor,
    decimals = 0
  ) %>%
  cols_align(
    align = "center",
    columns = everything()
  ) %>%
  tab_options(
    table.width = pct(70),
    heading.align = "center",
    table.font.size = px(13),
    data_row.padding = px(6)
  )

invisible(tabla_conteos_1_gt)

# ---------------------------------------------------------
# Punto 2
# ---------------------------------------------------------

# ---------------------------------------------------------
# Inciso (a)
# ---------------------------------------------------------

tabla_roi <- data %>%
  select(Movie, Budget, Total_US_Gross, ROI_US)

tabla_roi_gt <- tabla_roi %>%
  gt() %>%
  tab_header(
    title = md("**ROI de EE. UU. por Película**")
  ) %>%
  fmt_number(
    columns = c(Budget, Total_US_Gross),
    decimals = 2
  ) %>%
  fmt_number(
    columns = ROI_US,
    decimals = 4
  ) %>%
  cols_align(
    align = "center",
    columns = c(Budget, Total_US_Gross, ROI_US)
  ) %>%
  tab_options(
    table.width = pct(100),
    heading.align = "center",
    table.font.size = px(12),
    data_row.padding = px(5)
  )

invisible(tabla_roi_gt)

# ---------------------------------------------------------
# Inciso (b)
# ---------------------------------------------------------

prueba_ic_roi <- t.test(data$ROI_US, conf.level = 0.95)

tabla_ic_roi <- data.frame(
  Concepto = c("Media ROI_US", "Límite inferior", "Límite superior"),
  Valor = c(
    mean(data$ROI_US, na.rm = TRUE),
    prueba_ic_roi$conf.int[1],
    prueba_ic_roi$conf.int[2]
  )
)

tabla_ic_roi_gt <- tabla_ic_roi %>%
  gt() %>%
  tab_header(
    title = md("**Intervalo de Confianza al 95% para la Media de ROI_US**")
  ) %>%
  fmt_number(
    columns = Valor,
    decimals = 4
  ) %>%
  cols_align(
    align = "center",
    columns = everything()
  ) %>%
  tab_options(
    table.width = pct(75),
    heading.align = "center",
    table.font.size = px(13),
    data_row.padding = px(6)
  )

invisible(tabla_ic_roi_gt)

# ---------------------------------------------------------
# Inciso (c)
# ---------------------------------------------------------

prueba_hipotesis_roi <- t.test(data$ROI_US, mu = 0.12, alternative = "greater")

tabla_hipotesis_roi <- data.frame(
  Estadístico = c("t", "Valor p", "Media muestral", "Valor hipotético"),
  Valor = c(
    as.numeric(prueba_hipotesis_roi$statistic),
    prueba_hipotesis_roi$p.value,
    mean(data$ROI_US, na.rm = TRUE),
    0.12
  )
)

tabla_hipotesis_roi_gt <- tabla_hipotesis_roi %>%
  gt() %>%
  tab_header(
    title = md("**Prueba de Hipótesis: Media de ROI_US > 12%**")
  ) %>%
  fmt_number(
    columns = Valor,
    decimals = 6
  ) %>%
  cols_align(
    align = "center",
    columns = everything()
  ) %>%
  tab_options(
    table.width = pct(75),
    heading.align = "center",
    table.font.size = px(13),
    data_row.padding = px(6)
  )

invisible(tabla_hipotesis_roi_gt)

